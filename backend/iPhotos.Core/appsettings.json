{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=iphotos;Username=iphotos;Password=iphotos"
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "change-me-in-production-32-bytes-minimum!!",
      "Issuer": "iphotos",
      "Audience": "iphotos-client",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "30.00:00:00"
    },
    "Argon2": {
      "TimeCost": 3,
      "MemoryCost": 65536,
      "Lanes": 4
    }
  },
  "RateLimiting": {
    "AuthPermitLimit": 20
  },
  "Storage": {
    "DefaultQuotaBytes": 16106127360
  },
  "BlobStorage": {
    "Mode": "Filesystem",
    "RootPath": "data/blobs"
  },
  "StorageService": {
    "BaseUrl": "",
    "ApiKey": "",
    "Provider": "",
    "TimeoutSeconds": 100,
    "AllowPrivateNetworks": false
  },
  "Imaging": {
    "ThumbnailLongEdge": 320,
    "ThumbnailQuality": 75,
    "PreviewLongEdge": 2048,
    "PreviewQuality": 80
  },
  "Billing": {
    "Provider": "test",
    "Sandbox": true,
    "GracePeriodDays": 3,
    "SweepIntervalHours": 24,
    "Products": {
      "iphotos.cloud.1tb.monthly": {
        "DisplayName": "iPhotos Cloud 1 TB",
        "DisplayPrice": "$15/month",
        "QuotaBytes": 1099511627776
      }
    },
    "Test": {
      "TokenPrefix": "test_",
      "DurationDays": 30
    }
  }
}
